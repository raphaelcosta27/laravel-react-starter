# Opcional. Copie para docker/.env para mudar os padrões do ambiente Docker.
# Os parâmetros do sistema continuam no .env da raiz do projeto.

# Portas na máquina.
DOCKER_HTTP_PORT=8080
DOCKER_HTTPS_PORT=8443

# Liga o HTTPS. Exige docker/certs/server.crt e docker/certs/server.key.
DOCKER_SSL_ENABLED=false

# Banco. Com banco externo, use o endereço dele em DOCKER_DB_HOST e não ligue o perfil mysql.
DOCKER_DB_HOST=mysql
DOCKER_DB_DATABASE=template
DOCKER_DB_USERNAME=template
# A senha padrão só serve à rede interna. Troque antes de publicar.
DOCKER_DB_PASSWORD=template

# Perfis ligados sem precisar de --profile. Exemplo: mysql,redis
COMPOSE_PROFILES=mysql
