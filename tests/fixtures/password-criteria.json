{
    "criteria": [
        { "key": "length", "label": "At least 8 characters", "pattern": ".{8}" },
        { "key": "uppercase", "label": "One uppercase letter", "pattern": "\\p{Lu}" },
        { "key": "lowercase", "label": "One lowercase letter", "pattern": "\\p{Ll}" },
        { "key": "number", "label": "One number", "pattern": "\\p{N}" },
        { "key": "symbol", "label": "One special character", "pattern": "[\\p{P}\\p{S}\\p{Z}]" }
    ],
    "samples": [
        { "password": "", "met": [] },
        { "password": "abc", "met": ["lowercase"] },
        { "password": "ÁÉÍÓÚ", "met": ["uppercase"] },
        { "password": "12345678", "met": ["length", "number"] },
        { "password": "abcdefgh", "met": ["length", "lowercase"] },
        { "password": "Abcdefg1", "met": ["length", "uppercase", "lowercase", "number"] },
        { "password": "Ação-123", "met": ["length", "uppercase", "lowercase", "number", "symbol"] },
        { "password": "Senha Forte 1", "met": ["length", "uppercase", "lowercase", "number", "symbol"] },
        { "password": "senha😀1A", "met": ["length", "uppercase", "lowercase", "number", "symbol"] },
        { "password": "Ab1!", "met": ["uppercase", "lowercase", "number", "symbol"] }
    ]
}
