# Aplicação
# Nome exibido nas telas e nos e-mails.
APP_NAME=Template
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço local. Usado nos links dos e-mails; deve acompanhar SERVER_PORT.
APP_URL=http://127.0.0.1:8000
# Porta do servidor local.
SERVER_PORT=8000

# Idioma das telas e dos e-mails.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Dias de guarda dos arquivos de log. Exige o agendador ativo: veja o README.
LOG_DAILY_DAYS=14

# Identidade visual
# Caminhos públicos do logo e do ícone do navegador.
APP_LOGO=/images/logo.svg
APP_FAVICON=/favicon.ico
# Cores do tema, em hexadecimal e entre aspas, como "#3949ab". Vazio usa o padrão.
APP_PRIMARY_COLOR=
APP_SECONDARY_COLOR=

# Banco de dados
# Os valores abaixo seguem a instalação padrão do WAMP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template
DB_USERNAME=root
DB_PASSWORD=
# O WAMP usa MyISAM por padrão, que não comporta os índices de e-mail.
DB_ENGINE=InnoDB

# Sessão, cache e fila em arquivo, para a página inicial funcionar sem o banco.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Histórico de alterações: nomes de campo separados por vírgula
HISTORY_MASKED_FIELDS=password,remember_token
HISTORY_IGNORED_FIELDS=

# E-mail
# Com "log", as mensagens não são enviadas: ficam em storage/logs/laravel-AAAA-MM-DD.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contas
# Ativa a tela pública de registro.
REGISTRATION_ENABLED=false
# Validade da senha temporária e do link de confirmação, em minutos.
TEMPORARY_PASSWORD_EXPIRE=60

# Login
# Exige um código enviado por e-mail depois da senha. Depende do envio de e-mail.
LOGIN_TWO_FACTOR_ENABLED=true
# Validade do código, em minutos.
LOGIN_CODE_EXPIRE=15
# Tentativas erradas por código.
LOGIN_CODE_ATTEMPTS=5
# Códigos por usuário a cada período de validade, somando login e reenvio.
LOGIN_CODE_SEND_LIMIT=5

# Captcha do login (Cloudflare Turnstile). Ligado sem as duas chaves, recusa todo login.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tamanho mínimo das senhas, de 8 a 72.
PASSWORD_MIN_LENGTH=8

# Dados pessoais do perfil. Imagem em KB.
PROFILE_GENDERS="Female,Male,Non-binary,Prefer not to say,Other"
PROFILE_CPF_REQUIRED=false
PROFILE_AVATAR_MAX_KB=2048
PROFILE_AVATAR_DISK=local

# Parentescos dos contatos de emergência, traduzidos por lang/pt_BR.json.
PROFILE_RELATIONSHIPS="Mother,Father,Spouse or partner,Child,Sibling,Grandparent,Uncle or aunt,Cousin,Friend,Other relationship"

# Notificações em tela. O sino consulta o servidor a cada NOTIFICATIONS_POLL_SECONDS.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_POLL_SECONDS=60
NOTIFICATIONS_PER_PAGE=20

# Endereços. {cep} é trocado pelos dígitos; os serviços são tentados em ordem.
ADDRESS_DEFAULT_COUNTRY=Brasil
ADDRESS_POSTAL_CODE_URLS="https://viacep.com.br/ws/{cep}/json/,https://brasilapi.com.br/api/cep/v1/{cep}"

# Usuário inicial, criado por "php artisan app:setup".
INITIAL_USER_NAME=Administrador
# Troque antes de usar envio real de e-mail. Vazio não cria o usuário.
INITIAL_USER_EMAIL=admin@example.com
# Senha temporária, com os critérios de força. Vazia gera uma senha, enviada no e-mail de boas-vindas.
INITIAL_USER_PASSWORD=

# Painel de administrador
# Nomes dos perfis, usados somente na criação. Depois, renomeie pelo painel.
ADMIN_PROFILE_NAME=Administrador
DEFAULT_PROFILE_NAME=Usuário
# Envios de e-mail por usuário de destino, por janela de minutos.
ADMIN_EMAIL_THROTTLE=3
ADMIN_EMAIL_THROTTLE_MINUTES=10
# Separador das colunas no CSV exportado.
EXPORT_CSV_DELIMITER=;
