# Aplicação
# Nome exibido nas telas e nos e-mails.
APP_NAME=Template
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço local. Usado nos links dos e-mails; deve acompanhar SERVER_PORT.
APP_URL=http://127.0.0.1:8000
# Porta do servidor local.
SERVER_PORT=8000

# Idioma das telas e dos e-mails.
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Dias de guarda dos arquivos de log. Exige o agendador ativo: veja o README.
LOG_DAILY_DAYS=14

# Identidade visual
# Caminhos públicos do logo e do ícone do navegador.
APP_LOGO=/images/logo.svg
APP_FAVICON=/favicon.ico
# Cores do tema, em hexadecimal e entre aspas, como "#3949ab". Vazio usa o padrão.
APP_PRIMARY_COLOR=
APP_SECONDARY_COLOR=

# Banco de dados
# Os valores abaixo seguem a instalação padrão do WAMP.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=template
DB_USERNAME=root
DB_PASSWORD=
# O WAMP usa MyISAM por padrão, que não comporta os índices de e-mail.
DB_ENGINE=InnoDB

# Sessão, cache e fila em arquivo, para a página inicial funcionar sem o banco.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# E-mail
# Com "log", as mensagens não são enviadas: ficam em storage/logs/laravel-AAAA-MM-DD.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contas
# Ativa a tela pública de registro.
REGISTRATION_ENABLED=false
# Validade da senha temporária e do link de confirmação, em minutos.
TEMPORARY_PASSWORD_EXPIRE=60

# Usuário inicial, criado por "php artisan app:setup".
INITIAL_USER_NAME=Administrador
# Troque antes de usar envio real de e-mail. Vazio não cria o usuário.
INITIAL_USER_EMAIL=admin@example.com
# Senha temporária. Vazia gera uma senha, enviada no e-mail de boas-vindas.
INITIAL_USER_PASSWORD=

# Painel de administrador
# Nomes dos perfis, usados somente na criação. Depois, renomeie pelo painel.
ADMIN_PROFILE_NAME=Administrador
DEFAULT_PROFILE_NAME=Usuário
# Envios de e-mail por usuário de destino, por janela de minutos.
ADMIN_EMAIL_THROTTLE=3
ADMIN_EMAIL_THROTTLE_MINUTES=10
# Separador das colunas no CSV exportado.
EXPORT_CSV_DELIMITER=;
